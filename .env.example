# ~/second-brain-bot/.env: used by build.py, scripts/eval.py and scripts/harness.py (mode 600, git-ignored)
N8N_URL=http://localhost:5678
N8N_API_KEY=            # n8n → Settings → n8n API
SB_TEST_KEY=            # value of the "SB Test API key" header credential (X-SB-Key)

# ~/n8n/.env: read by the n8n container (compose.yaml passes them to n8n; Code nodes read them via $env)
# SB_NOTION_TOKEN=      # Notion internal integration secret (same integration as the "Notion account" credential)
# SB_GEMINI_API_KEY=    # Google AI Studio key
# SB_TELEGRAM_TOKEN=    # bot token (same as the n8n Telegram credential)
